# Fastify Server Port & Host
PORT=4000
HOST=0.0.0.0

# Persistent Data Directory (Defaults to ./data or /app/data in Docker)
DATA_DIR=./data

# Public URL of the Web Application (used for generating share links)
PUBLIC_URL=http://localhost:3000

# Telegram MTProto API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated automatically during first login (or paste an existing GramJS/Telethon string session)
TELEGRAM_SESSION_STRING=
